#!/usr/bin/env bash
# Run the `trade` CLI: the installed one if present, otherwise straight from GitHub via uvx.
# Usage: scripts/trade --json positions
set -euo pipefail
if command -v trade >/dev/null 2>&1; then
  exec trade "$@"
fi
if command -v uvx >/dev/null 2>&1; then
  exec uvx --quiet --from "agent-trading-journal[yahoo] @ git+https://github.com/MaximSinyaev/agent-trading-journal@v1.3.0" trade "$@"
fi
echo '{"ok": false, "error": "trade CLI not found. Install uv (https://docs.astral.sh/uv/) or run: pipx install \"agent-trading-journal[yahoo] @ git+https://github.com/MaximSinyaev/agent-trading-journal@v1.3.0\""}'
exit 127
